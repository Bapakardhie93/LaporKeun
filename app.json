{
  "expo": {
    "name": "LaporKeun",
    "slug": "laporkeun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "laporkeun",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LaporKeun menggunakan lokasi Anda untuk menampilkan posisi pada peta dan menghitung jarak ke laporan terdekat."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LaporKeun menggunakan foto untuk melengkapi laporan kondisi lingkungan.",
          "cameraPermission": "LaporKeun menggunakan kamera untuk memotret kondisi lingkungan.",
          "microphonePermission": false
        }
      ],
      "react-native-maps",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
